<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:aop="http://www.springframework.org/schema/aop"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
		http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-4.0.xsd">
	
	<bean id ="dept1" class = "com.test.Department">
		<property name="id" value="101"></property>
		<property name="name" value="IT"></property>
	</bean>

	
	<bean id = "dept2" class="com.test.Department">
		<constructor-arg name ="id" value="102"></constructor-arg>
		<constructor-arg name="name" value="Marketing"></constructor-arg>	
	</bean>
	
	<bean id = "cmp1" class = "com.test.Company">
		<property name="id" value = "1"></property>
		<property name="name" value = "Mphasis"></property>
	</bean>
	
	<bean id="cmp2" class ="com.test.Company">
		<constructor-arg name="id" value="2"></constructor-arg>
		<constructor-arg name = "name" value="TCS"></constructor-arg>
	</bean>
	
	<bean id="emp1" class="com.test.Employee">
		<property name="id" value="201"></property>
		<property name="name" value="Rohit"></property>
		<property name="dept">
			<ref bean="dept1"/>
		</property>
		<property name="cmp">
				<ref bean="cmp1" />	
		</property>
	</bean>
	
	<bean id="emp2" class="com.test.Employee">
		<constructor-arg name="id" value="202"></constructor-arg>
		<constructor-arg name = "name" value="Kohli"></constructor-arg>
		
			
		<constructor-arg name = "dept">
		
		<ref bean="dept2"/>
		
		</constructor-arg>
		
		<constructor-arg name = "cmp">
		
		<ref bean="cmp2"/>
		
		</constructor-arg>
	
	</bean>
	
	
</beans>
